#!/usr/bin/env python3
"""Enable a DMS plugin by seeding ~/.config/DankMaterialShell/plugin_settings.json.

    dms-plugin-enable attentionBadges

WHY THIS EXISTS. `dms plugins install <id>` clones the plugin and stops there — it
does not enable it, and the CLI has no enable subcommand at all (`dms plugins` offers
browse/install/list/uninstall/update). Enabling is a GUI toggle, and the state it
writes lives in a file of its OWN, not in settings.json:

    PluginService.qml:334
        const isPureDesktop = surfaces.length === 1 && surfaces[0] === "desktop";
        const enabled = isPureDesktop || SettingsData.getPluginSetting(id, "enabled", false);
        if (enabled && !info.loaded) runStartupGate(id);

    SettingsData.qml:81
        readonly property string pluginSettingsPath:
            _configDir + "/DankMaterialShell/plugin_settings.json"

So with no plugin_settings.json the lookup returns the `false` default and the plugin
is never loaded. The failure is silent and reads as a broken widget: the settings
baseline carries {"id": "attentionBadges"} in barConfigs[].rightWidgets, so the bar
holds an entry for a plugin that is installed, correct, and simply switched off.
Measured on mkMac2014, 2026-08-17, after a clean install.sh run.

The isPureDesktop bypass covers desktop-only plugins; anything with a dankbar widget
needs the stored flag.

MERGE, NEVER OVERWRITE. This file also holds each plugin's own settings, written by
the GUI, so it is not deployable the way settings.json is — the key is set in place
and everything else is left alone. It stays writable (0644) for the same reason:
read-only would freeze every in-GUI plugin setting, which is not what is wanted here.

A run that changes nothing writes nothing, so `dms restart` is only ever suggested
when the flag actually moved.
"""

import argparse
import json
import os
import sys
import tempfile

TARGET = os.path.expanduser("~/.config/DankMaterialShell/plugin_settings.json")


def load(path):
    """The store as a dict. A missing file is the normal fresh-machine case; an
    unreadable one is not, and is refused rather than replaced — this file belongs
    to DMS and may hold settings that exist nowhere else."""
    if not os.path.exists(path):
        return {}
    with open(path, encoding="utf-8") as handle:
        text = handle.read().strip()
    if not text:
        return {}
    return json.loads(text)


def enable(store, plugin_ids):
    """Set enabled=true for each id, returning (new_store, changed_ids)."""
    updated = json.loads(json.dumps(store))
    changed = []
    for plugin_id in plugin_ids:
        entry = updated.setdefault(plugin_id, {})
        if entry.get("enabled") is True:
            continue
        entry["enabled"] = True
        changed.append(plugin_id)
    return updated, changed


def write(path, store):
    """Atomic, like DMS's own writer (Quickshell FileView uses atomicWrites), so a
    failure cannot leave a half-written store behind."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    mode = os.stat(path).st_mode & 0o777 if os.path.exists(path) else 0o644
    handle, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".plugin_settings.")
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as out:
            out.write(json.dumps(store, indent=2) + "\n")
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        # Cleanup on every failing path, not just the JSON one: os.replace is the
        # step most likely to fail (a read-only mount over the target), and it
        # fails AFTER the temp file exists.
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("plugins", nargs="*", default=["attentionBadges"],
                        help="plugin ids to enable (default: attentionBadges)")
    parser.add_argument("--target", default=TARGET,
                        help="where the store lives (default: %(default)s)")
    parser.add_argument("--dry-run", action="store_true",
                        help="print what would change and write nothing")
    args = parser.parse_args()

    plugins = args.plugins or ["attentionBadges"]

    try:
        store = load(args.target)
    except (OSError, ValueError) as error:
        print(f"cannot read {args.target}: {error}", file=sys.stderr)
        print("refusing to overwrite it — fix or move it aside and re-run.", file=sys.stderr)
        return 1

    updated, changed = enable(store, plugins)

    if not changed:
        print(f"already enabled: {', '.join(plugins)}")
        return 0

    print(f"enabling in {args.target}: {', '.join(changed)}")
    if args.dry_run:
        return 0

    try:
        write(args.target, updated)
    except OSError as error:
        print(f"cannot write {args.target}: {error}", file=sys.stderr)
        return 1

    # Same trap as settings.json and as a freshly installed plugin: what a running
    # shell holds was decided at startup.
    print("run `dms restart` to load it.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
