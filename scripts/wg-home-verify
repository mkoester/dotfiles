#!/usr/bin/env bash
#
# wg-home-verify — check the wg-home full tunnel and its IPv6 leak guard, ON THE
# MACHINE THAT RUNS THE TUNNEL. Read-only: it changes nothing.
#
# Run it tethered to a phone hotspot, not at home. Half these checks are
# STRUCTURALLY INCAPABLE of failing on the home LAN, because 192.0.2.0/24 is a
# connected route that beats the tunnel (NetworkManager's suppress_prefixlength 0),
# and `curl -4 ifconfig.me` returns the home WAN IP whether the tunnel is up or
# down. Three results were misread that way on 2026-08-20 before anyone tethered.
# This script detects that case and reports SKIP rather than a green tick.
#
# Companion to /etc/NetworkManager/dispatcher.d/50-wg-home-ipv6-guard, installed
# by install.sh from dotfiles/system/networkmanager/. Background and the router
# side: Homelab-Documentation/WireGuard-Clients.md.

set -uo pipefail

TUNNEL=wg-home
ENDPOINT=endpoint.example          # DynDNS A record == the home WAN IPv4, so it is the
                            # expected value of `curl -4` and needs no hardcoding
HOME_LAN=192.0.2.
PASS=0; FAIL=0; SKIP=0

pass() { printf '\033[1;32m  ok  \033[0m%s\n' "$*"; PASS=$((PASS+1)); }
fail() { printf '\033[1;31m FAIL \033[0m%s\n' "$*"; FAIL=$((FAIL+1)); }
skip() { printf '\033[1;33m skip \033[0m%s\n' "$*"; SKIP=$((SKIP+1)); }
note() { printf '\033[1;34m  ::  \033[0m%s\n' "$*"; }

# ── where are we? ────────────────────────────────────────────────────────────
# home|foreign|unknown. The asymmetry matters: calling a home LAN "foreign" runs
# the egress checks where they cannot fail and reports a FALSE PASS, while the
# reverse merely skips them. So anything we cannot positively identify as foreign
# is treated as home.
locate() {
	local addrs
	addrs=$(ip -4 -o addr show 2>/dev/null \
		| grep -v " $TUNNEL " \
		| awk '{print $4}' | cut -d/ -f1 \
		| grep -v '^127\.')
	if [ -z "$addrs" ]; then
		echo unknown
	elif printf '%s\n' "$addrs" | grep -q "^$HOME_LAN"; then
		echo home
	else
		echo foreign
	fi
}

WHERE=$(locate)

echo
case "$WHERE" in
	home)
		note "on the HOME LAN — the egress checks cannot discriminate here and are skipped."
		note "Tether to the phone hotspot (with the phone's own WireGuard OFF) for a real run."
		;;
	foreign)
		note "on a foreign network — all checks are meaningful."
		;;
	unknown)
		note "cannot determine the network (no non-loopback IPv4 address found)."
		note "Treating as HOME and skipping the egress checks: a wrong 'foreign' here"
		note "would report a false pass rather than a false failure."
		;;
esac
echo

# ── 1. the dispatcher guard is installed the way NM demands ──────────────────
GUARD=/etc/NetworkManager/dispatcher.d/50-wg-home-ipv6-guard
if [ ! -e "$GUARD" ]; then
	fail "no dispatcher guard at $GUARD — run dotfiles/install.sh"
elif [ -L "$GUARD" ]; then
	# NM requires a regular file; a symlink is ignored SILENTLY, which looks
	# exactly like the guard not working (man NetworkManager-dispatcher).
	fail "$GUARD is a symlink — NetworkManager ignores it silently"
elif [ ! -x "$GUARD" ]; then
	fail "$GUARD is not executable — NetworkManager skips it"
else
	owner=$(stat -c '%U' "$GUARD")
	mode=$(stat -c '%a' "$GUARD")
	if [ "$owner" != root ]; then
		fail "$GUARD is owned by $owner, not root — NetworkManager ignores it"
	elif [ "$((8#$mode & 8#022))" -ne 0 ]; then
		fail "$GUARD is mode $mode — group/world writable, NetworkManager ignores it"
	else
		pass "dispatcher guard installed (root, $mode)"
	fi
fi

# ── 2. is the tunnel actually up? ────────────────────────────────────────────
if ip link show "$TUNNEL" >/dev/null 2>&1; then
	pass "$TUNNEL interface exists"
else
	fail "$TUNNEL is down — bring it up (DMS network menu, or: nmcli connection up $TUNNEL)"
	echo; printf '%d passed, %d failed, %d skipped\n' "$PASS" "$FAIL" "$SKIP"
	exit 1
fi

# ── 3. does the v4 default route go through it? ──────────────────────────────
# This is the check that discriminates full vs split tunnel, and unlike curl it
# works on the home LAN too.
if ip route get 8.8.8.8 2>/dev/null | grep -q "dev $TUNNEL"; then
	pass "IPv4 default route is inside the tunnel (full tunnel)"
else
	fail "IPv4 default route is NOT in the tunnel — split, not full"
	note "  $(ip route get 8.8.8.8 2>&1 | head -1)"
fi

# ── 4. is the IPv6 blackhole in place? ───────────────────────────────────────
if ip -6 route show default 2>/dev/null | grep -q '^blackhole'; then
	pass "IPv6 blackhole default route present (leak guard active)"
else
	fail "no IPv6 blackhole route — the dispatcher did not fire"
	note "  check: journalctl -u NetworkManager-dispatcher --since '10 min ago'"
fi

# ── 5/6. egress, which only means anything off-LAN ───────────────────────────
if [ "$WHERE" != foreign ]; then
	skip "IPv4 egress identity (returns the home WAN IP either way from here)"
	skip "IPv6 egress is blocked (no meaningful IPv6 path to test from here)"
else
	# BOUNDED. With the tunnel up, 192.0.2.1 is the exclusive resolver and is only
	# reachable THROUGH the tunnel, so an unbounded lookup here blocks forever and the
	# script looks hung with no output (observed on mkMac2014, 2026-08-20). Every
	# network call below is bounded for the same reason.
	expected=$(timeout 5 getent ahostsv4 "$ENDPOINT" 2>/dev/null | awk 'NR==1{print $1}')
	actual=$(curl -4 -s --max-time 10 ifconfig.me 2>/dev/null)
	if [ -z "$expected" ]; then
		skip "IPv4 egress identity — could not resolve $ENDPOINT to compare against"
	elif [ "$actual" = "$expected" ]; then
		pass "IPv4 egress is the home WAN IP ($actual)"
	else
		fail "IPv4 egress is $actual, expected $expected ($ENDPOINT) — traffic is NOT tunnelled"
	fi

	# Re-check the tunnel BEFORE judging IPv6. Steps 2-4 ran minutes ago; if the tunnel
	# has dropped since, the guard correctly removes the blackhole and IPv6 starts
	# working again — which is right, and would be reported here as a leak. A false
	# accusation is worse than no answer, so establish the precondition first.
	if ! ip link show "$TUNNEL" >/dev/null 2>&1; then
		skip "IPv6 egress — $TUNNEL went down during the run; re-run with it up"
	elif ! ip -6 route show default 2>/dev/null | grep -q '^blackhole'; then
		skip "IPv6 egress — the blackhole route disappeared mid-run; nothing to conclude"
	else
		# The guard works when this FAILS. A returned address is the leak.
		v6=$(curl -6 -s --max-time 8 ifconfig.me 2>/dev/null)
		if [ -z "$v6" ]; then
			pass "IPv6 egress is blocked (curl -6 returned nothing)"
		else
			fail "IPv6 LEAKED: curl -6 returned $v6 — that address is outside the tunnel"
		fi
	fi
fi

echo
printf '%d passed, %d failed, %d skipped\n' "$PASS" "$FAIL" "$SKIP"
[ "$FAIL" -eq 0 ]
