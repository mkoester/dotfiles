#!/usr/bin/env bash
# scripts/test — unit tests for lib.sh, the function library behind install.sh.
#
# It sources lib.sh and drives one function at a time against a fixture, so it exercises the REAL
# code without running an install. Nothing here touches $HOME, the package manager or the network:
# every test works in a fresh mktemp dir and is safe to run on any machine.
#
# Run: ./scripts/test        (add -v to see each passing case)
set -uo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
VERBOSE=0; [ "${1:-}" = "-v" ] && VERBOSE=1

DOTFILES_REPO="$REPO"
# shellcheck source=../lib.sh
. "$REPO/lib.sh"

PASS=0; FAIL=0; SKIP=0
is() {  # is <got> <want> <name>
	if [ "$1" = "$2" ]; then
		PASS=$((PASS + 1)); [ "$VERBOSE" -eq 1 ] && printf '  ok   %s\n' "$3"
	else
		FAIL=$((FAIL + 1))
		printf '  FAIL %s\n       got:  %s\n       want: %s\n' "$3" "$1" "$2" >&2
	fi
	return 0
}
ok() { is "$1" 1 "$2"; }                                    # <1|0> <name>
skip() { SKIP=$((SKIP + 1)); printf '  skip %s (%s)\n' "$1" "$2"; }
section() { printf '\n%s\n' "$1"; }

work() { mktemp -d "${TMPDIR:-/tmp}/dotfiles-test.XXXXXX"; }

# ── lower ────────────────────────────────────────────────────────────────────
section "lower"
is "$(lower 'YeS')" 'yes' 'uppercases folded'
is "$(lower '')" '' 'empty string survives'

# ── detect_pm ────────────────────────────────────────────────────────────────
section "detect_pm"
is "$(DOTFILES_PM=dnf detect_pm)" 'dnf' 'DOTFILES_PM overrides detection'
# No assertion on the bare call: the right answer depends on the host. Assert only that it
# answers *something* this machine could act on — an empty PM makes install.sh prompt.
case "$(detect_pm)" in pacman|apt|dnf|brew|'') r=1 ;; *) r=0 ;; esac
ok "$r" 'returns a known package manager (or empty)'

# ── record_answer ────────────────────────────────────────────────────────────
section "record_answer"
ANSWERS=(); record_answer DF_NODE 1
is "${ANSWERS[*]}" 'DF_NODE=1' 'a host-class answer is recorded'
ANSWERS=(); record_answer DF_STOW_BACKUP 0
is "${#ANSWERS[@]}" '0' 'DF_STOW_BACKUP is never recorded (per-conflict, not a machine property)'

# ── ask_yn ───────────────────────────────────────────────────────────────────
section "ask_yn"
ASSUME=0; RECONFIGURE=0; DRYRUN=0

ANSWERS=(); DF_T=1; ask_yn DF_T 'q?' >/dev/null && r=1 || r=0
ok "$r" 'a stored 1 answers yes'
is "${#ANSWERS[@]}" '0' 'a stored answer is not re-recorded'

ANSWERS=(); DF_T=0; ask_yn DF_T 'q?' >/dev/null && r=1 || r=0
is "$r" 0 'a stored 0 answers no'
ANSWERS=(); DF_T=yes; ask_yn DF_T 'q?' >/dev/null && r=1 || r=0
ok "$r" 'yes/true/y spellings are accepted'

# --reconfigure re-asks, and ENTER keeps the stored answer.
ANSWERS=(); DF_T=1; RECONFIGURE=1
ask_yn DF_T 'q?' >/dev/null <<<'' && r=1 || r=0
ok "$r" '--reconfigure + ENTER keeps the stored yes'
is "${ANSWERS[*]}" 'DF_T=1' '…and re-records it'
ANSWERS=(); DF_T=1
ask_yn DF_T 'q?' >/dev/null <<<'n' && r=1 || r=0
is "$r" 0 '--reconfigure + "n" flips a stored yes'
is "${ANSWERS[*]}" 'DF_T=0' '…and records the flip'
RECONFIGURE=0

# --yes must never block on stdin: it takes the stored answer, or No where there is none.
ANSWERS=(); ASSUME=1; unset DF_T
ask_yn DF_T 'q?' >/dev/null </dev/null && r=1 || r=0
is "$r" 0 '--yes with no stored answer is No'
is "${#ANSWERS[@]}" '0' '--yes records nothing (it answered nothing)'
DF_T=1; ask_yn DF_T 'q?' >/dev/null </dev/null && r=1 || r=0
ok "$r" '--yes honours a stored yes'
ASSUME=0; unset DF_T

# ── save_answers ─────────────────────────────────────────────────────────────
section "save_answers"
HOSTNAME_SHORT=testhost

# The fixture carries the shape that matters: aligned comments, commented-out hints, an export.
d="$(work)"; HOST_DIR="$d"; cp "$REPO/tests/fixtures/host.env" "$d/host.env"
DRYRUN=0
ANSWERS=(DF_DESKTOP=0 DF_NODE=0 DF_GO=1 DF_TOPGRADE=1)
save_answers >/dev/null

get() { grep -E "^[[:space:]]*#?[[:space:]]*(export[[:space:]]+)?$1=" "$d/host.env"; }
is "$(get DF_DESKTOP)" 'DF_DESKTOP=0     # Wayland desktop: bar, kanshi, notifications, ydotool' \
	'a live line keeps its trailing comment and column'
is "$(get DF_NODE)" 'DF_NODE=0        # commented-out hint: NOT an answer, must be uncommented in place' \
	'a "#" hint is uncommented, set, and the comment column held'
is "$(get DF_GO)" 'DF_GO=1          # same, with a space after the "#"' \
	'a "# " hint (two chars) is uncommented and re-padded by two'
is "$(grep -c '^DF_NODE=' "$d/host.env")" '1' 'no second copy of a hinted key is appended'
is "$(get DF_TOPGRADE)" 'DF_TOPGRADE=1' 'a genuinely new key is appended'
is "$(grep -c -F "$ANSWER_MARKER" "$d/host.env")" '1' '…under the marker, written once'
is "$(get DF_STOW_BACKUP)" '#DF_STOW_BACKUP=0' 'an untouched key is left commented'
is "$(grep -c '^export MUSIC_EXPORT_ROOT=' "$d/host.env")" '1' 'unrelated export lines survive'
is "$(get FPCALC)" '#export FPCALC="/usr/bin/fpcalc"' 'a commented export is NOT uncommented'
# It must still be a file bash and zsh can source.
( set +u; . "$d/host.env" ) >/dev/null 2>&1 && r=1 || r=0
ok "$r" 'the result still sources in bash'
if command -v zsh >/dev/null 2>&1; then
	zsh -fc ". '$d/host.env'" >/dev/null 2>&1 && r=1 || r=0
	ok "$r" 'the result still sources in zsh (it is read at shell start)'
else
	skip 'zsh sourcing' 'zsh not installed'
fi

# THE control: re-saving the answers a file already stores must be a byte-for-byte no-op.
# Without this, a rewrite that quietly reflows the file would pass every assertion above.
cp "$d/host.env" "$d/before"
ANSWERS=(DF_DESKTOP=0 DF_NODE=0 DF_GO=1 DF_TOPGRADE=1)
save_answers >/dev/null
cmp -s "$d/before" "$d/host.env" && r=1 || r=0
ok "$r" 'unchanged answers rewrite the file identically (idempotent)'

# …and flipping exactly one answer must change exactly one line.
ANSWERS=(DF_GO=0); save_answers >/dev/null
is "$(diff "$d/before" "$d/host.env" | grep -c '^[<>]')" '2' 'one flipped answer changes one line'

# The same round-trip against this machine's REAL host.env, when the private repo is cloned —
# the fixture is a copy of a shape, this is the shape itself.
real="$(dirname "$REPO")/workstation-private/$(hostname -s 2>/dev/null || hostname)/host.env"
if [ -f "$real" ]; then
	d2="$(work)"; HOST_DIR="$d2"; cp "$real" "$d2/host.env"
	ANSWERS=()
	while IFS= read -r line; do ANSWERS+=("$line"); done < <(
		grep -oE '^[[:space:]]*DF_[A-Z_]+=[01]' "$real" | tr -d '[:blank:]')
	if [ "${#ANSWERS[@]}" -gt 0 ]; then
		save_answers >/dev/null
		cmp -s "$real" "$d2/host.env" && r=1 || r=0
		ok "$r" "replaying $(hostname -s)'s own stored answers is a no-op"
	else
		skip 'real host.env round-trip' 'no DF_* answers stored'
	fi
	rm -rf "$d2"
else
	skip 'real host.env round-trip' 'workstation-private not cloned beside this repo'
fi

# Guard rails: --dry-run writes nothing, and a missing HOST_DIR warns instead of failing.
cp "$REPO/tests/fixtures/host.env" "$d/host.env"
HOST_DIR="$d"; DRYRUN=1; ANSWERS=(DF_DESKTOP=0)
save_answers >/dev/null
cmp -s "$REPO/tests/fixtures/host.env" "$d/host.env" && r=1 || r=0
ok "$r" '--dry-run writes nothing'
DRYRUN=0
HOST_DIR="$d/does-not-exist"; ANSWERS=(DF_DESKTOP=0)
save_answers >/dev/null 2>&1 && r=1 || r=0
ok "$r" 'a missing HOST_DIR warns and returns cleanly'
ok "$([ ! -e "$d/does-not-exist" ] && echo 1 || echo 0)" '…and creates nothing'
rm -rf "$d"

# ── unlink_omz ───────────────────────────────────────────────────────────────
# Only a symlink resolving back into THIS repo may be removed: on a machine where ~/src/dotfiles
# owns the links, a run from another clone must leave them alone.
section "unlink_omz"
d="$(work)"; HOME="$d"; DRYRUN=0
mkdir -p "$d/.oh-my-zsh-custom" "$d/foreign"
ln -s "$REPO/oh-my-zsh-custom/gita.zsh" "$d/.oh-my-zsh-custom/gita.zsh"
unlink_omz oh-my-zsh-custom gita.zsh >/dev/null 2>&1
ok "$([ ! -e "$d/.oh-my-zsh-custom/gita.zsh" ] && echo 1 || echo 0)" 'a link into this repo is removed'

: >"$d/foreign/other.zsh"; ln -s "$d/foreign/other.zsh" "$d/.oh-my-zsh-custom/other.zsh"
unlink_omz oh-my-zsh-custom other.zsh >/dev/null 2>&1
ok "$([ -L "$d/.oh-my-zsh-custom/other.zsh" ] && echo 1 || echo 0)" "another clone's link is kept"

: >"$d/.oh-my-zsh-custom/real.zsh"
unlink_omz oh-my-zsh-custom real.zsh >/dev/null 2>&1
ok "$([ -f "$d/.oh-my-zsh-custom/real.zsh" ] && echo 1 || echo 0)" 'a real file is kept'

unlink_omz oh-my-zsh-custom absent.zsh >/dev/null 2>&1
is "$?" 0 'an absent link is a clean no-op'

ln -s "$REPO/oh-my-zsh-custom/gone-for-good.zsh" "$d/.oh-my-zsh-custom/broken.zsh"
unlink_omz oh-my-zsh-custom broken.zsh >/dev/null 2>&1
ok "$([ ! -e "$d/.oh-my-zsh-custom/broken.zsh" ] && [ ! -L "$d/.oh-my-zsh-custom/broken.zsh" ] && echo 1 || echo 0)" \
	'a broken link into this repo is removed'
rm -rf "$d"

# ── stow_conflicts ───────────────────────────────────────────────────────────
# The parser has to cope with two stow message shapes; whichever this machine's stow emits, a
# pre-existing real file must come back as a bare relative path.
section "stow_conflicts"
if command -v stow >/dev/null 2>&1; then
	d="$(work)"
	: >"$d/.gitconfig"
	out="$(stow_conflicts "$d" git)"
	printf '%s\n' "$out" | grep -qx '.gitconfig' && r=1 || r=0
	ok "$r" 'a colliding real file is reported as a relative path'
	is "$(printf '%s\n' "$out" | grep -c '^\*\|cannot stow\|not owned')" '0' 'stow prose is stripped'
	rm -f "$d/.gitconfig"
	is "$(stow_conflicts "$d" git)" '' 'no conflicts on a clean target'
	rm -rf "$d"
else
	skip 'stow_conflicts' 'stow not installed'
fi

# ── syntax ───────────────────────────────────────────────────────────────────
section "syntax"
bash -n "$REPO/lib.sh" 2>/dev/null && r=1 || r=0;    ok "$r" 'lib.sh parses'
bash -n "$REPO/install.sh" 2>/dev/null && r=1 || r=0; ok "$r" 'install.sh parses'
# install.sh must not grow its own copy of a helper: one definition, in lib.sh.
is "$(grep -cE '^[a-z_]+\(\) \{' "$REPO/install.sh")" '0' 'install.sh defines no functions of its own'
# The last statement's status IS the script's exit status, so a trailing `[ … ] && …` makes a
# successful run exit non-zero whenever the condition is false. That is how install.sh shipped
# exiting 1 on every real (non-dry) run. The completion test above cannot catch it — it uses
# --dry-run, which is precisely the case that makes the condition true — so it is asserted here
# statically instead.
last="$(grep -vE '^[[:space:]]*(#|$)' "$REPO/install.sh" | tail -1)"
printf '%s' "$last" | grep -qE '^[[:space:]]*\[ .* \] &&' && r=0 || r=1
ok "$r" "install.sh does not end in a bare '[ … ] && …'"

# ── install.sh runs to completion ────────────────────────────────────────────
# A REGRESSION TEST, not a nicety. install.sh twice died mid-run under `set -euo pipefail`
# while printing nothing that looked like an error: a `grep` with no match inside a command
# substitution (pipefail promotes grep's exit 1), and a trailing `[ … ] && …` whose false
# condition became the script's exit status. Both left every later step un-run — including
# save_answers, so answers were silently never stored.
#
# The point is WHAT is asserted. Checking that some warning is absent cannot tell "correctly
# skipped" from "died before printing it"; only "did it reach the last step, and exit 0" can.
# Both cases below are needed: the Noctalia probe greps for packages, so the no-match path —
# a machine with nothing wrong — is the one that used to be fatal.
section "install.sh runs to completion"
if command -v stow >/dev/null 2>&1; then
	d="$(work)"
	mkdir -p "$d/bin" "$d/home"

	# Stub package manager: keeps this off the real package db and the network, and makes the
	# run deterministic on non-Arch hosts too (DOTFILES_PM pins the branch). `-Qq` is what the
	# Noctalia probe reads, so its output is how each case is set up.
	stub_pm() {
		{
			printf '#!/usr/bin/env bash\n'
			printf 'if [ "$1" = "-Qq" ]; then printf "%%s\\n" bash zsh %s; exit 0; fi\n' "$1"
			printf 'exit 0\n'
		} >"$d/bin/pacman"
		chmod u+x "$d/bin/pacman"
	}
	# Every DF_* is exported so the run cannot pick up this machine's stored host.env answers.
	# An exported DF_* is also never persisted, so no repo is touched.
	run_install() {
		PATH="$d/bin:$PATH" HOME="$d/home" DOTFILES_PM=pacman \
		DF_DESKTOP=0 DF_NIRI=0 DF_HYPR=1 DF_DMS=1 DF_QUADLET=0 DF_ATUIN=0 DF_NODE=0 \
		DF_TOPGRADE=0 DF_CADDY=0 DF_GO=0 DF_WSL=0 DF_GITA=0 DF_FRESH=0 DF_LESSPIPE=0 \
		DF_STOW_BACKUP=0 \
			bash "$REPO/install.sh" --dry-run --yes 2>&1
	}

	stub_pm ''                     # no Noctalia installed — the case that used to be fatal
	out="$(run_install)"; rc=$?
	printf '%s' "$out" | grep -q '9/9  Done' && r=1 || r=0
	ok "$r" 'reaches the final step with no Noctalia installed'
	is "$rc" '0' 'exits 0 with no Noctalia installed'
	is "$(printf '%s' "$out" | grep -c 'Noctalia is installed')" '0' 'no Noctalia warning when none is installed'

	stub_pm 'noctalia cachyos-hypr-noctalia'
	out="$(run_install)"; rc=$?
	printf '%s' "$out" | grep -q '9/9  Done' && r=1 || r=0
	ok "$r" 'reaches the final step with Noctalia installed'
	is "$rc" '0' 'exits 0 with Noctalia installed'
	is "$(printf '%s' "$out" | grep -c 'Noctalia is installed')" '1' 'warns when Noctalia is installed alongside DMS'

	rm -rf "$d"
else
	skip 'install.sh runs to completion' 'stow not installed'
fi

section 'hyprbinds — keybind cheat sheet'
HB="$REPO/config-stow/hypr/.local/bin/hyprbinds"
FX="$REPO/tests/fixtures"
if ! command -v python3 >/dev/null 2>&1; then
	skip 'hyprbinds' 'python3 not installed'
else
	# Both inputs are fixtures, so this never needs a compositor or a DMS install.
	hb() { python3 "$HB" --binds-json "$FX/hyprbinds-binds.json" --dms-lua "$FX/hyprbinds-dms.lua" "$@"; }
	# Bind rows are indented; group headers start with the box-drawing rule. Counting every
	# non-empty line would silently count headers as binds.
	rows() { hb "$@" | grep -c '^ '; }

	is "$(rows --view all)" '13' 'all view keeps every live bind'

	# Classification. SUPER+M is the one that matters: DMS declares it, we unbound it and rebound
	# it with our own description — the exact case DMS's own cheat sheet gets wrong.
	is "$(rows --view mine)" '3' 'mine view = our binds only'
	is "$(rows --view dms)" '10' 'dms view = DMS binds only'
	hb --view mine | grep -q '^ \* SUPER+M .*Workspace: mail$' && r=1 || r=0
	ok "$r" 'a DMS key we rebound is attributed to us, with our label'
	# Anchored: an unanchored 'SUPER+M' also matches SUPER+MOUSE:272 and passes for the wrong reason.
	hb --view dms | grep -q '^SUPER+M ' && r=0 || r=1
	ok "$r" 'that key no longer appears as a DMS bind'

	# Labels for DMS rows must come from the .lua file: the live table only says "__lua".
	hb --view dms | grep -q 'SUPER+SPACE .*Spotlight: toggle$' && r=1 || r=0
	ok "$r" 'an undescribed DMS bind is labelled from its dispatcher'
	hb --view dms | grep -q 'SUPER+Q .*Close window' && r=1 || r=0
	ok "$r" 'a non-exec dispatcher is labelled too'

	# Curated view: 13 -> drop 3 noise -> merge the arrow/letter twin -> collapse the digit run.
	is "$(rows --view curated)" '7' 'curated view drops noise, merges aliases, collapses digits'
	is "$(hb --view curated | grep -c 'XF86\|MOUSE:\|CODE:')" '0' 'curated drops XF86, mouse and keycode binds'
	hb --view curated | grep -q 'SUPER+LEFT / SUPER+H .*Focus left' && r=1 || r=0
	ok "$r" 'arrow and letter twins merge into one row'
	hb --view curated | grep -q 'SUPER+1…3 .*Focus workspace 1…3' && r=1 || r=0
	ok "$r" 'a numbered-workspace run collapses to one row'

	# Ours are never curated away, however noisy the key looks.
	is "$(hb --view curated | grep -c '^ \*')" '3' 'curated always keeps our own binds'

	# The no-DMS machine. Without this the fallback silently files everything as [dms] and the
	# sheet claims a plain-Hyprland box is running DMS.
	is "$(python3 "$HB" --binds-json "$FX/hyprbinds-binds.json" --dms-lua /nonexistent --view mine | grep -c '^ \*')" '13' \
		'with no DMS bind file, every bind is ours'

	# Grouping. Headers must appear, and every bind must land under one -- a row whose group is
	# unmapped falls into "Other", which is the tell that DMS renamed a section.
	# 4, not 7: the fixture only populates Workspaces, Windows, Focus & movement and Launchers.
	is "$(hb --view curated | grep -c '^── ')" '4' 'curated renders one header per non-empty group'
	is "$(hb --view all | grep -c '^── Other ')" '0' 'no bind falls through to the Other group'

	# The label is the LAST field and is never padded, so it cannot be pushed off a narrow
	# window -- which is what the old right-hand [src] column did.
	is "$(hb --view curated | grep '^ ' | grep -c ' $')" '0' 'no row has trailing padding'

	# Colour is opt-in: piped output must stay plain so these greps match text, not escapes.
	is "$(hb --view curated | grep -c $'\033')" '0' 'piped output carries no ANSI escapes'
	# Every line is coloured (header or bind), so the count equals the line count -- asserting a
	# literal would just re-encode the fixture size.
	is "$(hb --view curated --color | grep -c $'\033')" "$(hb --view curated | grep -c .)" \
		'the --color flag colours every line'
fi

section 'hypr-switcher — MRU window picker'
HS="$REPO/config-stow/hypr/.local/bin/hypr-switcher"
if ! command -v python3 >/dev/null 2>&1; then
	skip 'hypr-switcher' 'python3 not installed'
else
	# One fixture stands in for the compositor, so this needs no Hyprland — and could not use
	# one anyway: hyprctl is unreachable from inside the Claude Code sandbox.
	hs() { python3 "$HS" --clients-json "$REPO/tests/fixtures/hypr-switcher-clients.json" "$@"; }
	rows() { hs "$@" | grep -c .; }

	# 7 clients in, 4 out: the switcher's own window, a special workspace and an unmapped
	# window are each dropped. Asserting the count alone would pass if the wrong three went.
	is "$(rows)" '4' 'three unusable clients are filtered out'
	is "$(hs | grep -c 'mk.switcher')" '0' "the switcher's own window is not in its own list"
	is "$(hs | grep -c 'special')" '0' 'special workspaces are excluded'
	is "$(hs | grep -c 'half-mapped')" '0' 'unmapped windows are excluded'

	# THE ORDERING RULE, and the reason this script exists. focusHistoryID 1 is the window you
	# were just in and must be row 1 so ENTER-on-open flips to it; the FOCUSED window (id 0)
	# must be LAST, never preselected. A plain ascending sort would put it first and fail here.
	is "$(hs | head -1 | cut -f2 | awk '{print $1}')" 'herdr' 'the previously focused window is row 1'
	is "$(hs | tail -1 | cut -f2 | awk '{print $1}')" 'code' 'the focused window is moved to the end'

	# The address is a hidden first field (fzf --with-nth=2..); losing it breaks focusing while
	# the visible list still looks perfect.
	is "$(hs | head -1 | cut -f1)" '0xaaa3' 'each row carries its address as field 1'

	# A title with a tab or a newline would desync the columns or split one window across two
	# rows -- the fixture's herdr title contains both.
	is "$(hs | grep -c 'herdr split line')" '1' 'tabs and newlines in a title are collapsed'

	# Scope filters resolve against the FOCUSED window, not the first row.
	is "$(rows --scope workspace)" '1' 'workspace scope keeps only the focused workspace'
	is "$(rows --scope monitor)" '3' 'monitor scope keeps only the focused monitor'

	# Colour is opt-in so the greps above match text rather than escapes.
	is "$(hs | grep -c $'\033')" '0' 'piped output carries no ANSI escapes'
	is "$(hs --color | grep -c $'\033')" '4' 'the --color flag colours every row'

	# COLUMN HEADERS. The risk is drift: a header padded from different widths than the body
	# reads as misalignment, which is worse than no header at all. So assert the CLASS label
	# starts at the same offset as the class value in the first row, rather than just that a
	# header exists. The fixture's longest class (org.mozilla.Thunderbird, 23) is wider than
	# the word CLASS, and its longest workspace (herdr, 5) is NARROWER than WORKSPACE — so the
	# header widens that column and both directions of the max() are exercised.
	is "$(hs --with-header | head -1 | grep -bo 'CLASS' | cut -d: -f1)" \
		"$(hs --with-header | sed -n 2p | cut -f2- | grep -bo 'com.mitchellh.ghostty' | cut -d: -f1)" \
		'the CLASS header sits exactly over the class column'
	is "$(hs --with-header | head -1)" 'WORKSPACE  CLASS                    TITLE' 'header labels all three columns'

	# The header is OPT-IN: the default output stays pure data, or every consumer above (and
	# any future script piping this) would have to skip a line it did not ask for.
	is "$(rows)" "$(($(rows --with-header) - 1))" 'the header is absent unless --with-header'

	# An empty client list must render nothing and exit clean, not traceback: it is the state
	# right after the last window closes.
	d=$(work); echo '[]' >"$d/empty-clients.json"
	python3 "$HS" --clients-json "$d/empty-clients.json" >/dev/null 2>&1 && r=1 || r=0
	rm -rf "$d"
	ok "$r" 'an empty client list exits cleanly'
fi

# ── gitar ────────────────────────────────────────────────────────────────────
# gitar is a zsh function that rewrites gita's registry, so it cannot be run for
# real in a test (or from a sandbox — ~/.config/gita is not writable there).
# Drive it against a STUB `gita` on PATH instead: that exercises the real
# function end to end — the fake HOME, the glob, the group choice — and records
# the exact argv it would have issued.
section "gitar"
if command -v zsh >/dev/null 2>&1; then
	d="$(work)"
	mkdir -p "$d/bin" "$d/Projects/okf/.git" "$d/Projects/workspace_extensions/.git" "$d/src/dotfiles/.git"
	mkdir -p "$d/.config/DankMaterialShell/attention-providers/herdr/.git"
	mkdir -p "$d/.config/DankMaterialShell/attention-providers/thunderbird/.git"
	# A provider directory that is NOT a clone: a flat-file provider's neighbour,
	# or someone's notes. It must be skipped, not handed to gita.
	mkdir -p "$d/.config/DankMaterialShell/attention-providers/notes"
	mkdir -p "$d/.config/gita"

	cat >"$d/bin/gita" <<-'STUB'
		#!/usr/bin/env bash
		[ "$1" = "ls" ] && exit 0
		printf '%s\n' "$*" >>"$GITA_LOG"
	STUB
	chmod u+x "$d/bin/gita"

	GITA_LOG="$d/calls.log" \
	HOME="$d" PATH="$d/bin:$PATH" \
		zsh -fc "source '$REPO/oh-my-zsh-custom/gita.zsh'; gitar" >/dev/null 2>&1
	log="$(cat "$d/calls.log" 2>/dev/null)"

	ok "$(printf '%s' "$log" | grep -qF "add -g workspace_extensions $d/.config/DankMaterialShell/attention-providers/herdr" && echo 1 || echo 0)" \
		'a provider clone joins workspace_extensions'
	ok "$(printf '%s' "$log" | grep -qF "add -g workspace_extensions $d/.config/DankMaterialShell/attention-providers/thunderbird" && echo 1 || echo 0)" \
		'every provider clone is added, not just the first'
	# -a would give each clone a group of its own, which is the whole thing this
	# guards against; assert the group flag rather than merely "it was added".
	ok "$(printf '%s' "$log" | grep -qF "add -a $d/.config/DankMaterialShell/attention-providers" && echo 0 || echo 1)" \
		'the providers directory does not become its own group'
	ok "$(printf '%s' "$log" | grep -qF "attention-providers/notes" && echo 0 || echo 1)" \
		'a non-repo provider directory is skipped'
	# The clone dirs are short on purpose, so gita would name them `herdr` and
	# `thunderbird` — unrecognisable in a list of 50 repos. gitar re-adds on every
	# run, so the rename cannot be done by hand: it would last until the next one.
	ok "$(printf '%s' "$log" | grep -qF "rename thunderbird dms-attention-badges-thunderbird" && echo 1 || echo 0)" \
		'a provider clone is renamed to say what it belongs to'
	ok "$(printf '%s' "$log" | grep -qF "rename herdr dms-attention-badges-herdr" && echo 1 || echo 0)" \
		'every provider clone is renamed, not just the first'
	# Order: gita has to know the repo by its derived name before it can rename it.
	ad=$(printf '%s\n' "$log" | grep -n "add -g workspace_extensions $d/.config/DankMaterialShell/attention-providers/herdr\$" | cut -d: -f1)
	rn=$(printf '%s\n' "$log" | grep -n "rename herdr " | cut -d: -f1)
	ok "$([ -n "$ad" ] && [ -n "$rn" ] && [ "$ad" -lt "$rn" ] && echo 1 || echo 0)" \
		'the rename follows the add that created the name'
	# Order is load-bearing: gita fixes group order by add order, so the group
	# must already exist from the workspace pass before the providers join it.
	ws=$(printf '%s\n' "$log" | grep -n "add -a $d/Projects/workspace_extensions\$" | cut -d: -f1)
	pv=$(printf '%s\n' "$log" | grep -n "add -g workspace_extensions" | head -1 | cut -d: -f1)
	ok "$([ -n "$ws" ] && [ -n "$pv" ] && [ "$ws" -lt "$pv" ] && echo 1 || echo 0)" \
		'the workspace group is created before the providers join it'

	rm -rf "$d"
else
	skip "gitar" "zsh not installed"
fi

# ── dms-plugin-enable ────────────────────────────────────────────────────────
# Every case runs against a --target in a temp dir, so nothing here can touch the
# real DMS store.
section "dms-plugin-enable"
DPE="$REPO/scripts/dms-plugin-enable"

d=$(work); t="$d/plugin_settings.json"

# The case that made this script exist: a machine with the plugin installed and no
# store at all.
python3 "$DPE" attentionBadges --target "$t" >/dev/null 2>&1
is "$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["attentionBadges"]["enabled"])' "$t")" \
	'True' 'a missing store is created with the plugin enabled'

# The whole reason it merges rather than deploys: this file also holds each plugin's
# own GUI-written settings, and a sibling plugin's entry must survive untouched.
cat >"$t" <<-'JSON'
	{
	  "otherPlugin": { "enabled": true, "interval": 42 },
	  "attentionBadges": { "enabled": false, "showZero": true }
	}
JSON
python3 "$DPE" attentionBadges --target "$t" >/dev/null 2>&1
is "$(python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));print(d["otherPlugin"]["interval"])' "$t")" \
	'42' 'another plugin keeps its settings'
is "$(python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));print(d["attentionBadges"]["showZero"])' "$t")" \
	'True' "the plugin's own settings survive the flip"
is "$(python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));print(d["attentionBadges"]["enabled"])' "$t")" \
	'True' 'a stored false is flipped to true'

# A no-op run must not rewrite the file: install.sh calls this on every pass, and a
# needless write would suggest a `dms restart` that is not needed.
before=$(md5sum <"$t")
out=$(python3 "$DPE" attentionBadges --target "$t" 2>&1)
is "$(md5sum <"$t")" "$before" 'a second run leaves the file byte-identical'
ok "$(printf '%s' "$out" | grep -qF 'already enabled' && echo 1 || echo 0)" \
	'a no-op run says so'
ok "$(printf '%s' "$out" | grep -qF 'dms restart' && echo 0 || echo 1)" \
	'a no-op run does not suggest a restart'

# The control that makes the no-op assertions above worth anything: a run that DOES
# change something must write and must say so. Without it, a script that silently
# did nothing at all would pass every test above.
python3 -c 'import json;json.dump({"attentionBadges":{"enabled":False}},open("'"$t"'","w"))'
out=$(python3 "$DPE" attentionBadges --target "$t" 2>&1)
ok "$(printf '%s' "$out" | grep -qF 'dms restart' && echo 1 || echo 0)" \
	'a real change suggests a restart'

# A corrupt store is DMS's file, possibly holding settings that exist nowhere else.
# Refusing beats replacing.
printf 'not json at all\n' >"$t"
python3 "$DPE" attentionBadges --target "$t" >/dev/null 2>&1 && r=0 || r=1
ok "$r" 'a corrupt store fails rather than being replaced'
is "$(cat "$t")" 'not json at all' 'the corrupt store is left untouched'
ok "$(find "$d" -name '.plugin_settings.*' | grep -q . && echo 0 || echo 1)" \
	'no temp file is left behind'

# --dry-run is what install.sh's own --dry-run relies on staying honest.
rm -f "$t"
python3 "$DPE" attentionBadges --target "$t" --dry-run >/dev/null 2>&1
ok "$([ -f "$t" ] && echo 0 || echo 1)" '--dry-run writes nothing'

# Defaulting to attentionBadges is what lets install.sh name it explicitly without the
# two drifting apart — assert the default is the same id, not merely that one exists.
rm -f "$t"
python3 "$DPE" --target "$t" >/dev/null 2>&1
is "$(python3 -c 'import json,sys;print(",".join(json.load(open(sys.argv[1]))))' "$t")" \
	'attentionBadges' 'the default plugin id is attentionBadges'

rm -rf "$d"

# ── dms-settings-lift ────────────────────────────────────────────────────────
section "dms-settings-lift"
DSL="$REPO/scripts/dms-settings-lift"

d=$(work)
mkdir -p "$d/shared"
# A miniature of the real pair: base.json holds everything, laptop.json overrides
# one timeout and repeats barConfigs whole (which is exactly what goes stale).
cat >"$d/shared/base.json" <<-'JSON'
	{
	  "clockFormat": "auto",
	  "cornerRadius": 12,
	  "batteryLockTimeout": 0,
	  "notificationHistoryEnabled": true,
	  "greeterSyncPending": false,
	  "greeterSyncBaseline": {},
	  "barConfigs": [ { "id": "default", "spacing": 4, "rightWidgets": ["clock"] } ]
	}
JSON
cat >"$d/shared/laptop.json" <<-'JSON'
	{
	  "batteryLockTimeout": 120,
	  "barConfigs": [ { "id": "default", "spacing": 4, "rightWidgets": ["battery", "clock"] } ]
	}
JSON
# The paste: what the GUI would hand back after two ordinary tweaks, plus the
# greeter state DMS writes as a consequence of one of them.
cat >"$d/paste.json" <<-'JSON'
	{
	  "clockFormat": "24h",
	  "cornerRadius": 16,
	  "batteryLockTimeout": 120,
	  "notificationHistoryEnabled": true,
	  "greeterSyncPending": true,
	  "greeterSyncBaseline": { "clockFormat": "auto" },
	  "barConfigs": [ { "id": "default", "spacing": 4, "rightWidgets": ["battery", "clock"] } ]
	}
JSON
cp "$d/shared/base.json" "$d/base.orig.json"   # one case below applies the printed jq
# --class is PINNED, not left to auto-detection. The fixture's laptop.json carries
# batteryLockTimeout and barConfigs, so which keys are liftable depends entirely on
# the class — and with `auto` that means on whether the machine running the suite
# happens to have a battery. Written on a laptop, this block passed there and failed
# with six confusing errors on a desktop (mkDell, 2026-08-20), none of which named
# the class as the cause. A later case overrides it with an explicit `--class desktop`;
# argparse takes the last occurrence, so "${@:2}" still wins.
lift() { python3 "$DSL" "$1" --shared "$d/shared" --deployed "$d/absent.json" --class laptop "${@:2}" 2>&1; }

# Assert the pin took, so a future change to the helper fails HERE with an obvious
# message rather than as a scatter of unrelated-looking assertion failures below.
ok "$(lift "$d/paste.json" | grep -q '^class: laptop,' && echo 1 || echo 0)" \
	'the fixture runs as the laptop class regardless of the host machine'

out=$(lift "$d/paste.json")
ok "$(printf '%s' "$out" | grep -q '^LIFT — 2 key' && echo 1 || echo 0)" \
	'the two real changes are offered for base.json'
ok "$(printf '%s' "$out" | grep -qE '^  (clockFormat|cornerRadius):' && echo 1 || echo 0)" \
	'…and are named with their before/after values'

# The point of the whole script: transient state must not reach the baseline, and
# must not reach the printed command either.
ok "$(printf '%s' "$out" | grep -q 'EXCLUDED' && echo 1 || echo 0)" \
	'greeter sync state is reported as excluded'
ok "$(printf '%s' "$out" | grep "jq '" | grep -q 'greeterSync' && echo 0 || echo 1)" \
	'…and appears in no jq assignment'

# The strongest assertion available: run the command it printed and confirm the
# result merges back into the paste. A report whose command does not do what the
# report claims is the failure this catches, and nothing else here would.
prog=$(printf '%s' "$out" | sed -n "s/^  jq '\(.*\)' base.json.*/\1/p")
ok "$([ -n "$prog" ] && echo 1 || echo 0)" 'a jq program is printed'
jq "$prog" "$d/shared/base.json" >"$d/shared/base.new" && mv "$d/shared/base.new" "$d/shared/base.json"
is "$(jq -S -s '.[0] * .[1] | del(.greeterSyncPending, .greeterSyncBaseline)' \
		"$d/shared/base.json" "$d/shared/laptop.json" | md5sum)" \
	"$(jq -S 'del(.greeterSyncPending, .greeterSyncBaseline)' "$d/paste.json" | md5sum)" \
	'running the printed command makes base+laptop reproduce the paste'
out=$(lift "$d/paste.json")
ok "$(printf '%s' "$out" | grep -q 'nothing to lift' && echo 1 || echo 0)" \
	'a second run has nothing left to lift (idempotent)'

# The control that can fail: a barConfigs change must NOT produce a command, on
# either class. Lifting it into base.json alone leaves laptop.json's copy stale,
# which is silent and fleet-wide — see the script's docstring.
jq '.barConfigs[0].spacing=8' "$d/paste.json" >"$d/bar.json"
out=$(lift "$d/bar.json")
ok "$(printf '%s' "$out" | grep -q '^STOP' && echo 1 || echo 0)" \
	'a barConfigs change is refused'
ok "$(printf '%s' "$out" | grep -q "jq '" && echo 0 || echo 1)" \
	'…and no command is printed to copy-paste'
out=$(lift "$d/bar.json" --class desktop)
ok "$(printf '%s' "$out" | grep -q '^STOP' && echo 1 || echo 0)" \
	'…on the desktop class too, where the overlay is not even loaded'

# An overlay key is the other half of the same guard.
jq '.batteryLockTimeout=600' "$d/paste.json" >"$d/bat.json"
out=$(lift "$d/bat.json")
ok "$(printf '%s' "$out" | grep -q '^STOP' && echo 1 || echo 0)" \
	'a laptop-overlay timeout is refused'

# The suspect heuristic is anchored on purpose: notificationHistoryEnabled and
# notificationHistoryMaxCount are real settings, so an unanchored "History" match
# would silently drop them. This is the case that proves the anchor works.
cp "$d/base.orig.json" "$d/shared/base.json"   # the lift case above mutated it
jq '.notificationHistoryEnabled=false' "$d/paste.json" >"$d/hist.json"
out=$(lift "$d/hist.json")
ok "$(printf '%s' "$out" | grep -q '^LIFT — 3 key' && echo 1 || echo 0)" \
	'notificationHistoryEnabled is not mistaken for state'
ok "$(printf '%s' "$out" | grep -q 'notificationHistoryEnabled=false' && echo 1 || echo 0)" \
	'…and is lifted normally'

# A key the baseline does not have at all is a DMS upgrade, not a tweak.
jq '.brandNewKey="x"' "$d/paste.json" >"$d/new.json"
out=$(lift "$d/new.json")
ok "$(printf '%s' "$out" | grep -q 'NEW KEYS' && echo 1 || echo 0)" \
	'a key absent from the baseline is flagged as new'

# Report-only means report-only: nothing it is pointed at may change.
before=$(md5sum <"$d/paste.json")
lift "$d/paste.json" >/dev/null
is "$(md5sum <"$d/paste.json")" "$before" 'the paste is never modified'
ok "$([ ! -e "$d/absent.json" ] && echo 1 || echo 0)" 'no deployed file is created'

rm -rf "$d"

# ── wg-home IPv6 leak guard (NetworkManager dispatcher) ────────────────────
# Driven as the real script with a stubbed `ip` on PATH, since it needs root and a
# live tunnel otherwise. The stub records its argv; the assertions are on what the
# script ASKED the kernel to do, not on a return value.
d="$(mktemp -d "${TMPDIR:?TMPDIR must be set}/wgguard.XXXXXX")"
GUARD="$REPO/system/networkmanager/50-wg-home-ipv6-guard"
mkdir -p "$d/bin"
cat >"$d/bin/ip" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$IP_LOG"
STUB
chmod u+x "$d/bin/ip"

guard() {
	IP_LOG="$d/ip.log" PATH="$d/bin:$PATH" "$GUARD" "$1" "$2" >/dev/null 2>&1
}

: >"$d/ip.log"; guard wg-home up
is "$(cat "$d/ip.log")" '-6 route replace blackhole default metric 1' \
	'up installs the blackhole default route'

: >"$d/ip.log"; guard wg-home down
is "$(cat "$d/ip.log")" '-6 route del blackhole default metric 1' \
	'down removes it'

# The guard must ignore every other interface — a wifi up must not blackhole IPv6.
# This is the assertion that matters most: getting it wrong kills IPv6 permanently.
: >"$d/ip.log"; guard wlan0 up
is "$(wc -c <"$d/ip.log")" "0" 'a non-tunnel interface is ignored on up'
: >"$d/ip.log"; guard wlan0 down
is "$(wc -c <"$d/ip.log")" "0" 'a non-tunnel interface is ignored on down'

# Actions we do not handle must be inert on the tunnel too (dhcp4-change etc).
: >"$d/ip.log"; guard wg-home dhcp4-change
is "$(wc -c <"$d/ip.log")" "0" 'an unhandled action does nothing'

# pre-up/pre-down are handled as well as up/down, so the leak window at activation
# is closed and a pre-down does not leave the route behind.
: >"$d/ip.log"; guard wg-home pre-up
is "$(cat "$d/ip.log")" '-6 route replace blackhole default metric 1' \
	'pre-up also installs the route'

# Called with no arguments at all it must not act (dispatcher misconfiguration).
: >"$d/ip.log"; IP_LOG="$d/ip.log" PATH="$d/bin:$PATH" "$GUARD" >/dev/null 2>&1 || true
is "$(wc -c <"$d/ip.log")" "0" 'no arguments does nothing'

rm -rf "$d"

# ── wg-home-verify: where-am-I detection ──────────────────────────────────────
# This runs ON the tunnel machine and cannot be exercised here (the sandbox's own
# net namespace shows only lo), so the location logic is driven with fixtures via a
# stubbed `ip`. The asymmetry is the point: calling a home LAN "foreign" runs the
# egress checks where they CANNOT FAIL and reports a false pass, so anything not
# positively foreign must be treated as home.
d="$(mktemp -d "${TMPDIR:?TMPDIR must be set}/wgverify.XXXXXX")"
VERIFY="$REPO/scripts/wg-home-verify"
mkdir -p "$d/bin"
cat >"$d/bin/ip" <<'STUB'
#!/usr/bin/env bash
# Only `-4 -o addr show` is answered; everything else fails, so the script stops
# after the location note, which is all these cases assert on.
[ "$*" = "-4 -o addr show" ] || exit 1
cat "$ADDR_FIXTURE"
STUB
chmod u+x "$d/bin/ip"

# Captured into a variable, then grepped -- the idiom the rest of this suite uses.
# Piping the function straight into `grep -q` reports no match even when the text is
# plainly there: -q exits on the first hit, and the SIGPIPE that sends back through
# the function's own trailing `head` loses the result. That reads exactly like a
# detection bug in the script under test, which is what it was mistaken for.
# TEST-NET-1/2 (RFC 5737), never the real home subnet: this repo is PUBLIC. The
# script takes both values from the environment for the same reason, so the test
# supplies documentation ranges and asserts against those.
where() {
	ADDR_FIXTURE="$1" WG_HOME_ENDPOINT=endpoint.example \
		WG_HOME_LAN_PREFIX=192.0.2. PATH="$d/bin:$PATH" "$VERIFY" 2>/dev/null | head -5
}

printf '%s\n' \
	'1: lo    inet 127.0.0.1/8 scope host lo' \
	'2: wlan0    inet 192.0.2.43/24 brd 192.0.2.255 scope global wlan0' >"$d/home.txt"
out=$(where "$d/home.txt")
ok "$(printf '%s' "$out" | grep -q 'HOME LAN' && echo 1 || echo 0)" \
	'an address in the home subnet is detected as home'

printf '%s\n' \
	'1: lo    inet 127.0.0.1/8 scope host lo' \
	'2: wlan0    inet 198.51.100.12/24 brd 198.51.100.255 scope global wlan0' >"$d/away.txt"
out=$(where "$d/away.txt")
ok "$(printf '%s' "$out" | grep -q 'foreign network' && echo 1 || echo 0)" \
	'a hotspot address is detected as foreign'

printf '%s\n' '1: lo    inet 127.0.0.1/8 scope host lo' >"$d/lo.txt"
out=$(where "$d/lo.txt")
ok "$(printf '%s' "$out" | grep -q 'cannot determine' && echo 1 || echo 0)" \
	'loopback only is unknown, not foreign'

# The edge case that would otherwise read as "foreign": up, but with nothing except
# the tunnel address. The tunnel must not count as evidence of being away.
printf '%s\n' \
	'1: lo    inet 127.0.0.1/8 scope host lo' \
	'3: wg-home    inet 198.51.100.5/32 scope global wg-home' >"$d/tunonly.txt"
out=$(where "$d/tunonly.txt")
ok "$(printf '%s' "$out" | grep -q 'cannot determine' && echo 1 || echo 0)" \
	'the tunnel address alone does not count as a foreign network'

# Every network call must be BOUNDED. getent has no built-in timeout, and with the
# tunnel up the resolver is only reachable through the tunnel — so one unbounded
# lookup makes the whole script hang silently with no output, which is exactly what
# it did on mkMac2014 (2026-08-20). A lint assertion rather than a behavioural one,
# because the hang cannot be reproduced without a live tunnel.
# The reporting helpers are excluded because their message strings mention the very
# commands being looked for -- without this the lint flags its own error text.
unbounded=$(grep -vE '^[[:space:]]*#' "$VERIFY" \
	| grep -vE '^[[:space:]]*(pass|fail|skip|note|echo|printf) ' \
	| grep -E '\b(getent|curl|dig|nslookup|host)\b' \
	| grep -cvE 'timeout |--max-time' || true)
is "$unbounded" "0" 'every network call in wg-home-verify is bounded by a timeout'

rm -rf "$d"

# ── the repo is PUBLIC ────────────────────────────────────────────────────────
# Private identifiers reached the tracked tree on 2026-08-20 -- a DynDNS name that
# resolves to the home WAN IP, plus the home subnet -- and were pushed before anyone
# noticed. Nothing about a passing test suite or a clean diff showed it. This is the
# cheap check that would have.
section "public repo hygiene"
# Each pattern brackets one character so the expression does not match ITSELF in
# this file -- otherwise the guard reports its own source and needs an exclusion,
# which would blind it to the fixtures it is meant to police.
leaked=$(git -C "$REPO" grep -nE 'mkde\.m[e]|\b10\.1[0]\.[0-9]+\.|g[l]\.mk' -- . 2>/dev/null | wc -l)
is "$leaked" "0" 'no private hostnames or home-LAN addresses in the tracked tree'

printf '\n%d passed, %d failed, %d skipped\n' "$PASS" "$FAIL" "$SKIP"
[ "$FAIL" -eq 0 ]
