[Unit]
Description=ydotoold — uinput daemon for Wayland input injection (Stream Deck, macros)
Documentation=https://github.com/ReimuNotMoe/ydotool

[Service]
Type=simple
# ydotoold opens /dev/uinput to create a virtual input device, then listens on a control
# socket that the `ydotool` client talks to. Injecting input on Wayland is the whole point:
# clients (e.g. StreamController actions) call `ydotool key`/`ydotool type`.
#
# PREREQUISITE: access to /dev/uinput. Often ALREADY SATISFIED — check before changing anything.
#
# CORRECTED 2026-07-31. This used to prescribe:
#   KERNEL=="uinput", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
# plus membership in the `input` group. That works, but it is the EXPENSIVE route: the `input`
# group grants read access to every /dev/input/event* — i.e. every keystroke on the machine,
# permanently, for every process running as your user (udev puts ALL input devices in that group;
# systemd's session-scoped `uaccess` ACL covers only joysticks). Global keylogging exposure to buy
# event injection is a bad trade, and it is not needed:
#
#   - On a machine with `steam-devices`, /usr/lib/udev/rules.d/60-steam-input.rules already has
#       KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
#     which gives the LOGGED-IN user an ACL on /dev/uinput, revoked at logout. Nothing to do.
#   - Without steam-devices, drop that same `uaccess` line into /etc/udev/rules.d/ (a root step,
#     hence not stow-managed). Session-scoped, no group membership.
#
# Verify with `getfacl /dev/uinput` (expect a user:<you>:rw- entry) before adding any rule.
# Full reasoning: Workstation-Documentation/desktop/streamdeck-ydotool.md
ExecStart=/usr/bin/ydotoold
# The client finds the daemon via this socket; export the same path in your shell/session
# so `ydotool` (and StreamController) reach it: YDOTOOL_SOCKET=%t/.ydotool_socket
Environment=YDOTOOL_SOCKET=%t/.ydotool_socket
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
