#!/usr/bin/env bash
# gitaw-panel [group] — one frame of the `gitaw` live overview:
#
#   ── claude ──────────────────────── as of 14:23 (7h ago) ──
#     5h    ████████░░░░░░░░░░░░  42%   resets 17:39 (in 2h13m)
#     week  ██████████████░░░░░░  71%   resets Mon 14:59
#     extra ██░░░░░░░░░░░░░░░░░░  13%   3.93 / 30.00 EUR
#   ── repos ─────────────────────────────────────────────────
#     * unstaged   + staged   $ stashed   ? untracked
#     ↑ to push    ↓ to pull    ⇕ diverged   ∅ no remote
#
#   <gita ll -g, minus the clean repos>
#
# Split out of the `gitaw` zsh function because `watch` runs its command through
# `sh -c`, which cannot see zsh functions — the same reason gitad's grep used to
# be duplicated inside gitaw. Now there is one implementation and gitaw is a
# thin `watch` wrapper around this script.
#
# Every part degrades on its own: no python3 / no cached usage / no gita-legend
# just drops that block, the repo list always renders.
set -uo pipefail # deliberately not -e: a missing sub-part must not kill the frame

group="${1:-}"

# Terminal width, via /dev/tty rather than tput: under `watch` stdout is a PIPE,
# so tput/stty on stdout report the 80-column terminfo default. /dev/tty is the
# real terminal and is re-read every frame, so the rules follow a live resize.
width=0
# The redirect is inside a group so that bash's own "/dev/tty: No such device"
# — emitted when there is no controlling terminal at all, e.g. piped — is
# swallowed too; `stty ... 2>/dev/null` alone only silences stty.
if size="$({ stty size </dev/tty; } 2>/dev/null)"; then width="${size##* }"; fi
case "$width" in '' | *[!0-9]*) width=0 ;; esac
[ "$width" -ge 40 ] || width=80

DIM=$'\033[2m'
RESET=$'\033[0m'

# rule <label> [right-hand note] — "── label ────────── note ──", dimmed.
rule() {
	local label="$1" note="${2:-}" left right fill n
	left="── ${label} "
	right="${note:+ ${note} }──"
	n=$((width - ${#left} - ${#right}))
	[ "$n" -ge 0 ] || n=0
	fill=""
	while [ "${#fill}" -lt "$n" ]; do fill="${fill}──────────"; done
	printf '%s%s%s%s%s\n' "$DIM" "$left" "${fill:0:$n}" "$right" "$RESET"
}

# ── claude usage ──────────────────────────────────────────────────────────────
# Source is Claude Code's OWN cache in ~/.claude.json (cachedUsageUtilization) —
# the same numbers /usage shows — and refreshes them itself when they go stale.
#
# Two sources, newest wins:
#   ~/.claude.json          cachedUsageUtilization, written by Claude Code
#   $XDG_CACHE_HOME/gitaw/  usage.json, written by this script
# Claude Code updates its copy ONLY when you run /usage — ordinary API traffic
# does not (measured: 7h stale through a session making dozens of calls). So when
# the newest copy is older than the TTL, this fetches GET /api/oauth/usage with
# the OAuth token from ~/.claude/.credentials.json — the same endpoint /usage
# calls, read out of the Claude Code binary. Response shape is identical, so the
# renderer below cannot tell the two sources apart.
#
# It never writes anything Claude Code owns, and it cannot renew the token: that
# is Claude Code's job, so after a long Claude-free stretch the token expires and
# the fetch stops working. Every failure path — expired token, no network, no
# cache dir, changed payload — falls back to whatever cached value exists, and
# the rule keeps printing the true age. Worst case is the read-only behaviour
# this had before.
usage_block() {
	command -v python3 >/dev/null 2>&1 || return 0
	python3 - "$width" <<-'PY'
		import datetime as dt, json, os, sys, time, urllib.request

		width = int(sys.argv[1])
		DIM, RESET = "\033[2m", "\033[0m"
		GREEN, YELLOW, RED = "\033[32m", "\033[33m", "\033[31m"
		BARW = 20

		TTL = 300          # seconds; mirrors Claude Code's own 5-min write throttle
		TIMEOUT = 5        # a panel frame must not hang on a slow network
		URL = "https://api.anthropic.com/api/oauth/usage"
		CACHE = os.path.join(
		    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
		    "gitaw", "usage.json")


		def read_json(path):
		    try:
		        with open(path) as fh:
		            return json.load(fh)
		    except Exception:
		        return None


		def claude_cache():
		    d = (read_json(os.path.expanduser("~/.claude.json")) or {}).get(
		        "cachedUsageUtilization") or {}
		    if d.get("fetchedAtMs") and d.get("utilization"):
		        return d
		    return None


		def fetch():
		    """GET the live figures, or None. Also records the attempt: without a
		    stamp for FAILED tries the panel would retry every single frame, since a
		    failure leaves the cached value just as stale as it found it."""
		    own = read_json(CACHE) or {}
		    try:
		        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
		    except OSError:
		        return None      # nowhere to record attempts → never fetch at all
		    creds = (read_json(os.path.expanduser("~/.claude/.credentials.json")) or {}
		             ).get("claudeAiOauth") or {}
		    token = creds.get("accessToken")
		    # Skip a token we can already see is expired rather than spending a
		    # round-trip to be told 401. Only Claude Code can renew it.
		    if not token or creds.get("expiresAt", 0) / 1000 <= time.time():
		        return None

		    rec = dict(own)
		    rec["lastTryMs"] = time.time() * 1000
		    try:
		        req = urllib.request.Request(URL, headers={
		            "Authorization": f"Bearer {token}",
		            "anthropic-beta": "oauth-2025-04-20",
		        })
		        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
		            util = json.load(resp)
		        if not isinstance(util, dict) or "five_hour" not in util:
		            raise ValueError("unexpected payload")
		        rec["utilization"] = util
		        rec["fetchedAtMs"] = time.time() * 1000
		    except Exception:
		        rec = {**own, "lastTryMs": rec["lastTryMs"]}
		    try:
		        tmp = CACHE + f".{os.getpid()}"
		        with open(tmp, "w") as fh:
		            json.dump(rec, fh)
		        os.replace(tmp, CACHE)
		    except OSError:
		        pass
		    return rec if rec.get("utilization") else None


		def pick():
		    best = max(
		        [c for c in (claude_cache(), read_json(CACHE)) if c and c.get("fetchedAtMs")],
		        key=lambda c: c["fetchedAtMs"], default=None)
		    age = time.time() - best["fetchedAtMs"] / 1000 if best else float("inf")
		    # Attempts are rate-limited by lastTryMs, not by the data's age: a run of
		    # failures must not turn a 1-second refresh loop into a request flood.
		    last_try = (read_json(CACHE) or {}).get("lastTryMs", 0) / 1000
		    if age > TTL and time.time() - last_try > TTL:
		        return fetch() or best
		    return best


		cached = pick()
		if not cached:
		    sys.exit(0)
		util = cached["utilization"]

		now = dt.datetime.now(dt.timezone.utc)


		def ago(ms):
		    s = max(0, int((now.timestamp() * 1000 - ms) / 1000))
		    if s < 90:
		        return f"{s}s ago"
		    if s < 5400:
		        return f"{s // 60}m ago"
		    if s < 172800:
		        return f"{s // 3600}h ago"
		    return f"{s // 86400}d ago"


		def rule(label, note):
		    left, right = f"── {label} ", f" {note} ──" if note else "──"
		    fill = "─" * max(0, width - len(left) - len(right))
		    print(f"{DIM}{left}{fill}{right}{RESET}")


		def bar(pct, color):
		    filled = min(BARW, max(0, round(pct / 100 * BARW)))
		    return f"{color}{'█' * filled}{DIM}{'░' * (BARW - filled)}{RESET}"


		def resets(iso):
		    """'resets 17:39 (in 2h13m)', or a stale marker once the window has rolled over."""
		    try:
		        at = dt.datetime.fromisoformat(iso)
		    except ValueError:
		        return "", False
		    local = at.astimezone()
		    when = local.strftime("%H:%M") if local.date() == dt.datetime.now().date() \
		        else local.strftime("%a %H:%M")
		    left = (at - now).total_seconds()
		    if left <= 0:
		        # The window reset after this snapshot was taken, so the percentage
		        # below describes a window that no longer exists. Say so rather than
		        # rendering a stale 100% as if it were current.
		        return f"window reset {when} — figure is stale", True
		    h, m = int(left // 3600), int(left % 3600 // 60)
		    if h >= 24:
		        span = f"{h // 24}d {h % 24}h"  # a weekly window in hours reads as noise
		    elif h:
		        span = f"{h}h{m:02d}m"
		    else:
		        span = f"{m}m"
		    return f"resets {when} (in {span})", False


		rows = []
		for key, label in (
		    ("five_hour", "5h"),
		    ("seven_day", "week"),
		    ("seven_day_opus", "opus"),
		    ("seven_day_sonnet", "sonnet"),
		):
		    w = util.get(key)
		    if not w:
		        continue
		    pct = w.get("utilization")
		    if pct is None:
		        continue
		    note, stale = resets(w.get("resets_at") or "")
		    rows.append((label, float(pct), note, stale))

		extra = util.get("extra_usage") or {}
		if extra.get("is_enabled") and extra.get("utilization") is not None:
		    scale = 10 ** int(extra.get("decimal_places") or 2)
		    note = (f"{extra.get('used_credits', 0) / scale:.2f} / "
		            f"{extra.get('monthly_limit', 0) / scale:.2f} {extra.get('currency', '')}".strip())
		    rows.append(("extra", float(extra["utilization"]), note, False))

		if not rows:
		    sys.exit(0)

		fetched = cached.get("fetchedAtMs")
		stamp = ""
		if fetched:
		    stamp = (f"as of {dt.datetime.fromtimestamp(fetched / 1000):%H:%M} "
		             f"({ago(fetched)})")
		rule("claude", stamp)

		pad = max(len(r[0]) for r in rows)
		for label, pct, note, stale in rows:
		    if stale:
		        # Dim the whole row: the bar would otherwise read as current usage.
		        print(f"  {DIM}{label:<{pad}}  {'░' * BARW} {'—':>4}  {note}{RESET}")
		        continue
		    color = RED if pct >= 85 else YELLOW if pct >= 60 else GREEN
		    print(f"  {label:<{pad}}  {bar(pct, color)} {color}{pct:3.0f}%{RESET}"
		          f"  {DIM}{note}{RESET}")

		# Blank line before the repos rule. Emitted here, not by the caller, so it
		# appears only when there was actually a usage block to separate.
		print()
	PY
}

usage_block

# ── repos ─────────────────────────────────────────────────────────────────────
rule repos
if command -v gita-legend >/dev/null 2>&1; then
	gita-legend | sed "s/^/  ${DIM}/;s/$/${RESET}/"
fi
echo

# The gitad filter, inlined: clean repos render as "[]", and the trailing space
# anchors on gita's padded status column so a commit subject containing brackets
# (e.g. "[Save]") is not read as a flag.
# `-g` always, group name only when given — `gita ll -g` with no name groups all
# workspaces, which is what an argument-less gitaw showed before.
ll_args=(-g)
[ -n "$group" ] && ll_args+=("$group")
gita ll "${ll_args[@]}" | grep -v '\[\] '
