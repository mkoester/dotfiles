#!/usr/bin/env python3
"""Render a cached Codex subscription usage snapshot for gitaw-panel."""
import datetime as dt
import json
import os
import selectors
import shutil
import subprocess
import sys
import time

WIDTH = int(sys.argv[1]) if len(sys.argv) > 1 else 80
BARW = 20
TTL = 300
TIMEOUT = 10
CACHE_VERSION = 2
DIM, RESET = "\033[2m", "\033[0m"
GREEN, YELLOW, RED = "\033[32m", "\033[33m", "\033[31m"
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                     "gitaw", "codex-usage.json")


def read_cache():
    try:
        with open(CACHE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def request_usage():
    """Ask Codex's own authenticated App Server; never inspect auth files."""
    codex = shutil.which("codex")
    if not codex:
        return None
    proc = None
    try:
        proc = subprocess.Popen(
            [codex, "app-server", "--stdio"], stdin=subprocess.PIPE,
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1)
        selector = selectors.DefaultSelector()
        selector.register(proc.stdout, selectors.EVENT_READ)

        def send(message):
            proc.stdin.write(json.dumps(message) + "\n")
            proc.stdin.flush()

        def response_for(request_id):
            deadline = time.monotonic() + TIMEOUT
            while time.monotonic() < deadline:
                if not selector.select(max(0, deadline - time.monotonic())):
                    return None
                line = proc.stdout.readline()
                try:
                    response = json.loads(line)
                except ValueError:
                    continue
                if response.get("id") == request_id:
                    return response
            return None

        send({"method": "initialize", "id": 0, "params": {
            "clientInfo": {"name": "gitaw-panel", "title": "gitaw-panel", "version": "1"}}})
        if not response_for(0) or proc.poll() is not None:
            return None
        send({"method": "initialized"})
        send({"method": "account/rateLimits/read", "id": 1, "params": {}})
        response = response_for(1)
        if response and isinstance(response.get("result"), dict):
            return response["result"]
    except (OSError, subprocess.SubprocessError):
        pass
    finally:
        if proc:
            if proc.stdin and not proc.stdin.closed:
                proc.stdin.close()
            try:
                proc.wait(timeout=1)
            except subprocess.TimeoutExpired:
                proc.terminate()
                proc.wait(timeout=1)
    return None


def snapshot():
    cached = read_cache()
    if cached.get("version") != CACHE_VERSION:
        cached = {"version": CACHE_VERSION}
    now_ms = time.time() * 1000
    if now_ms - cached.get("fetchedAtMs", 0) < TTL * 1000:
        return cached.get("usage"), cached.get("fetchedAtMs")
    if now_ms - cached.get("lastTryMs", 0) < TTL * 1000:
        return cached.get("usage"), cached.get("fetchedAtMs")

    # Stamp failed attempts too, so a broken login or network does not spawn a
    # fresh App Server every frame. Retain the last known snapshot as fallback.
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    except OSError:
        return cached.get("usage"), cached.get("fetchedAtMs")
    cached["lastTryMs"] = now_ms
    usage = request_usage()
    if usage:
        cached["usage"] = usage
        cached["fetchedAtMs"] = time.time() * 1000
    try:
        tmp = CACHE + f".{os.getpid()}"
        with open(tmp, "w") as fh:
            json.dump(cached, fh)
        os.replace(tmp, CACHE)
    except OSError:
        pass
    return cached.get("usage"), cached.get("fetchedAtMs")


def main():
    usage, fetched = snapshot()
    if not usage:
        return
    now = dt.datetime.now().astimezone()
    age_s = max(0, int(time.time() - fetched / 1000)) if fetched else 0
    age = f"{age_s // 60}m ago" if age_s >= 90 else f"{age_s}s ago"
    stamp = f"as of {dt.datetime.fromtimestamp(fetched / 1000):%H:%M} ({age})" if fetched else ""

    limits = usage.get("rateLimitsByLimitId") or {}
    if not limits:
        limits = {"codex": usage.get("rateLimits") or {}}
    rows = []
    windows = (("primary", "primary"), ("secondary", "secondary"))
    for limit_id, rate_limit in sorted(
            limits.items(), key=lambda item: (item[0] != "codex", item[0])):
        limit_name = "" if limit_id == "codex" else (
            rate_limit.get("limitName") or
            (limit_id[6:] if limit_id.startswith("codex_") else limit_id).replace("_", " "))
        for window, fallback_label in windows:
            data = rate_limit.get(window)
            if not data or data.get("usedPercent") is None:
                continue
            duration = data.get("windowDurationMins")
            if duration is None:
                window_label = fallback_label
            elif duration >= 25 * 24 * 60:
                window_label = "month"
            elif duration >= 6 * 24 * 60:
                weeks = round(duration / (7 * 24 * 60))
                window_label = "week" if weeks == 1 else f"{weeks}w"
            elif duration >= 24 * 60:
                window_label = f"{round(duration / (24 * 60))}d"
            elif duration >= 60 and duration % 60 == 0:
                window_label = f"{round(duration / 60)}h"
            else:
                window_label = f"{round(duration)}m"
            label = f"{limit_name} {window_label}".strip()
            remaining = max(0, min(100, 100 - float(data["usedPercent"])))
            reset_at = data.get("resetsAt")
            note = ""
            stale = False
            if reset_at:
                reset = dt.datetime.fromtimestamp(reset_at, dt.timezone.utc).astimezone()
                seconds = int((reset - now).total_seconds())
                if seconds > 7 * 24 * 60 * 60:
                    when = reset.strftime("%Y-%m-%d")
                else:
                    when = reset.strftime("%H:%M") if reset.date() == now.date() else reset.strftime("%a %H:%M")
                if seconds <= 0:
                    note, stale = f"window reset {when} — figure is stale", True
                else:
                    hours, minutes = divmod(seconds // 60, 60)
                    span = f"{hours // 24}d {hours % 24}h" if hours >= 24 else (
                        f"{hours}h {minutes:02d}m" if hours else f"{minutes}m")
                    note = f"resets {when} (in {span})"
            rows.append((label, remaining, note, stale))
    if not rows:
        return

    left, right = "── codex ", f" {stamp} ──" if stamp else "──"
    print(f"{DIM}{left}{'─' * max(0, WIDTH - len(left) - len(right))}{right}{RESET}")
    pad = max(len(row[0]) for row in rows)
    for label, remaining, note, stale in rows:
        if stale:
            print(f"  {DIM}{label:<{pad}}  {'░' * BARW} {'—':>4}  {note}{RESET}")
            continue
        used = 100 - remaining
        color = RED if used >= 85 else YELLOW if used >= 60 else GREEN
        filled = round(used / 100 * BARW)
        bar = f"{color}{'█' * filled}{DIM}{'░' * (BARW - filled)}{RESET}"
        print(f"  {label:<{pad}}  {bar} {color}{used:3.0f}%{RESET}  {DIM}{note}{RESET}")
    print()


if __name__ == "__main__":
    main()
