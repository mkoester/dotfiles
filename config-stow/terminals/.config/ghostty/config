# ghostty — config file is THIS one, `config`, with no extension.
#
# There is a sibling `config.ghostty` in this directory (0 bytes, created 2026-08-02) that is
# NOT read: the only filename in the ghostty 1.3.1 binary is the bare string `config`, and
# `ghostty +show-config` confirms which file actually took effect. Left in place rather than
# deleted, but do not put settings in it — an ignored config file fails silently.
#
# MesloLGS Nerd Font in every terminal (MK, 2026-08-10), from `ttf-meslo-nerd` 3.5.0-1.
# Use the FULL family name: `MesloLGS NF`, the abbreviation powerlevel10k's docs use, resolves
# to Noto Sans here (`fc-match "MesloLGS NF"`). A bad font name never errors, it just renders
# in the fallback — verify with `ghostty +show-config | grep font-family`.
font-family = MesloLGS Nerd Font
font-size = 12

# CTRL+C COPIES WHEN THERE IS A SELECTION, OTHERWISE INTERRUPTS.
#
# This is a keybind PREFIX, not an action — which is why it is invisible to
# `ghostty +list-actions` (85 actions, none of them a smart-copy) and why grepping the binary
# for a kitty-style `copy_or_interrupt` finds nothing. Ghostty expresses the behaviour by
# making an ordinary binding conditional instead of by adding a new action.
#
# Verified in the source at the tag actually installed here (v1.3.1), not recalled:
#   src/input/Binding.zig:48  `performable: bool` — "True if this binding should only be
#     triggered if the action can be performed. If the action can't be performed then the
#     binding acts as if it doesn't exist."
#   src/Surface.zig:5333      `.copy_to_clipboard` returns true only inside
#     `if (self.io.terminal.screens.active.selection) |sel|`, and `return false` otherwise.
#
# So: selection present -> copies and consumes the key; no selection -> the binding "does not
# exist" and ctrl+c reaches the program as usual (SIGINT in a shell, cancel in a TUI).
# Equivalent to kitty's `copy_or_noop`, which is what ~/.config/kitty/kitty.conf uses.
#
# `:mixed` matches ghostty's own default for ctrl+shift+c (plain + styled formats).
keybind = performable:ctrl+c=copy_to_clipboard

# CTRL+V PASTES — UNCONDITIONALLY, and note the DELIBERATE ABSENCE of `performable:` here.
#
# Adding that prefix would parse fine and do nothing: src/Surface.zig:6169 is
# `.paste => {}, // always allowed`, so the action can always be performed and the binding
# always consumes the key. kitty has no `paste_or_noop` either — there is no smart paste in
# any of the three terminals, so this is unconditional or nothing.
#
# Accepted cost (MK, 2026-08-10, "I almost never use vim anyway"):
#   vim/neovim  blockwise-visual mode — no alias, genuinely lost
#   zsh/bash    quoted-insert — cheap, CTRL+Q still does it (measured: zsh `bindkey` gives
#               "^V" quoted-insert, and bash reports it on both \C-q and \C-v)
# ghostty's default CTRL+SHIFT+V stays bound too, so this only adds a second way to paste.
keybind = ctrl+v=paste_from_clipboard

# MIDDLE-CLICK PASTE IS A GSETTING, NOT A GHOSTTY OPTION — AND IT IS OFF BY DEFAULT ON ARCH.
#
# This block used to say middle-click paste was unavailable and that shift+middle still worked.
# Both were wrong, and for one cause: ghostty's GTK apprt gates EVERY middle-click event on
# `org.gnome.desktop.interface gtk-enable-primary-paste`, whose glib schema default is `false`
# (`/usr/share/glib-2.0/schemas/org.gnome.desktop.interface.gschema.xml` — nothing here had
# overridden it, so it had never worked on this fleet). GNOME distros ship an override to true;
# Arch does not.
#
#   src/apprt/gtk/class/surface.zig @ v1.3.1
#     1786  priv.gtk_enable_primary_paste = gsettings.get(.@"gtk-enable-primary-paste") orelse true;
#     2794  if (button == .middle and !priv.gtk_enable_primary_paste) return;   // gcMouseDown
#     2854  if (button == .middle and !priv.gtk_enable_primary_paste) return;   // gcMouseUp
#
# The gate sits ABOVE the modifier handling, so with it false the event never reaches the paste
# path OR the mouse report — plain and shift+middle are equally dead, and nothing is logged.
# (Upstream #12940 calls the "not even forwarded to TUIs" half a regression from #10328.)
#
# `install.sh` sets it under DF_DESKTOP. By hand:
#   gsettings set org.gnome.desktop.interface gtk-enable-primary-paste true
# Read ONCE per surface init (line 1786), so open a NEW window/tab — existing panes keep the old
# value, which reads exactly like the setting not having worked.
#
# With it on, from src/Surface.zig @ v1.3.1 (`mouseButtonCallback`, and the paste at :4154):
#   no mouse reporting  plain middle pastes PRIMARY
#   grabbing TUI        plain middle goes to the app; SHIFT+MIDDLE pastes, because the report
#                       block breaks out on `mods.shift and !shift_capture` and falls through
#                       — i.e. it depends on `mouse-shift-capture = false`, ghostty's default.
#
# Still not available: plain middle-click INSIDE a grabbing TUI. Ghostty has no mouse BINDING
# map at all in 1.3.1, so it cannot be remapped; kitty can
# (`mouse_map middle release grabbed,ungrabbed paste_from_selection`). PR #12109
# (`middle-click-paste = selection|clipboard|false`) is NOT merged and the key is absent from
# the installed binary — don't add it.

# INSTALL xterm-ghostty ON REMOTE HOSTS AUTOMATICALLY, ON FIRST SSH.
#
# Needed because `ghostty-terminfo` exists ONLY on Arch: it is not packaged in Fedora or Debian
# (checked against mdapi.fedoraproject.org and packages.debian.org, where `kitty-terminfo` IS
# present in both — so the fleet's Fedora servers and the Pi cannot get it from a package, and
# install.sh installs what it can). Without it a bare ssh carries TERM=xterm-ghostty to a host
# that has never heard of it.
#
# The zsh integration (/usr/share/ghostty/shell-integration/zsh/ghostty-integration:333-383)
# wraps `ssh` as a function: it pipes `infocmp -0 -x xterm-ghostty` over the connection, runs
# `tic -x -` into the remote's ~/.terminfo, then caches the host via `ghostty +ssh-cache` so
# later connections skip straight to TERM=xterm-ghostty. If any of that fails it falls back to
# TERM=xterm-256color, which is strictly better than today's broken-remote default. Needs `tic`
# (ncurses) on the remote; no root, no package, nothing to install on the fleet.
#
# THE VALUE MERGES, it does not replace — measured, because the obvious reading is the opposite
# and a replacement here would silently drop `cursor`, `title` and `path`:
#   XDG_CONFIG_HOME=<scratch> ghostty +show-config
#   -> shell-integration-features = cursor,no-sudo,title,no-ssh-env,ssh-terminfo,path
# with the scratch config containing only the line below. So one feature name is the whole edit.
#
# `ssh-env` deliberately left OFF: it adds `-o SetEnv COLORTERM=truecolor` and `-o SendEnv
# TERM_PROGRAM…`, both of which need a matching AcceptEnv on the remote sshd and otherwise do
# nothing at all — silently. Enable it only alongside the sshd side.
#
# ⚠ CHANGING THIS KEY NEEDS A FULL GHOSTTY RESTART — A NEW WINDOW IS NOT ENOUGH, and the
# difference is invisible. `GHOSTTY_SHELL_FEATURES` is injected into the shell's environment
# when a surface spawns its command (src/termio/shell_integration.zig:222-235, which writes
# every enabled feature unconditionally), from the config the PROCESS holds. With
# `gtk-single-instance = detect` resolving true in a desktop session, every window — including
# ones opened by a Hyprland launcher or ctrl+shift+n — is served by the one long-lived process,
# so it keeps handing out the feature list it loaded at startup. Measured 2026-08-16: a new
# window still reported `cursor:blink,path,title` while
#   ghostty --gtk-single-instance=false -e zsh -ic 'echo $GHOSTTY_SHELL_FEATURES'
# reported `cursor:blink,path,ssh-terminfo,title` from the same file. Whether `reload_config`
# (ctrl+shift+,) is sufficient was NOT established — quit every ghostty process and relaunch.
#
# The failure is silent in both halves, which is why this is worth the paragraph: the env var
# simply lacks the feature, so no `ssh` wrapper is defined, so ssh runs bare and carries
# TERM=xterm-ghostty to a host that cannot resolve it. Nothing logs anything. Verify with
# `echo $GHOSTTY_SHELL_FEATURES` in a NEW PROCESS, never by re-reading this file or by trusting
# `ghostty +show-config` — both were correct throughout while the live shells were not.
shell-integration-features = ssh-terminfo
