# Managed by dotfiles — config-stow/ssh/.ssh/config
#
# ⚠ THIS REPO IS PUBLIC. No hostnames, no ports, no users, no internal IPs here.
# Private host entries live in workstation-private/shared/ssh/*.conf and are
# symlinked into ~/.ssh/config.d/ by install.sh, so they sync across machines
# without ever being published.
#
# Include comes FIRST on purpose: ssh_config takes the FIRST obtained value for
# each keyword, so anything in config.d/ OVERRIDES the defaults below. Move it
# to the bottom and the Host * block silently wins instead.

Include config.d/*.conf

Host *
	# Turn an unreachable host into a quick failure rather than an indefinite hang.
	# Worth knowing why this earns its place: ghostty's ssh-terminfo integration
	# prints "Setting up xterm-ghostty terminfo on <host>..." BEFORE it opens its
	# probe connection, so an unreachable host looks exactly like that step having
	# hung — and its own probe carries no timeout. Observed on mkMac2014, 2026-08-20.
	ConnectTimeout 10

	# Notice a dead peer instead of leaving a wedged session behind. This matters
	# on the wg-home full tunnel, where the path can vanish under an open session.
	ServerAliveInterval 60
	ServerAliveCountMax 3

	# Add a key to the agent on first use rather than re-prompting every session.
	AddKeysToAgent yes

# DELIBERATELY NOT SET: ControlMaster/ControlPath multiplexing. It would speed up
# repeated connections, but ghostty's ssh-terminfo wrapper opens its own master
# with an explicit -o ControlMaster=yes and -o ControlPath=<its own socket>, and
# the interaction between that and a global setting here has not been tested.
# Measure it before enabling — a half-working multiplex fails as a hang.
