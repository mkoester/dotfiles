# fixture host.env — shaped like a real workstation-private/<hostname>/host.env, because that
# shape IS the difficulty: aligned trailing comments, a commented-out hint, an `export` line and
# a key the installer never stores. A fixture of bare `VAR=1` lines would pass whatever
# save_answers does to the padding and the "#", i.e. prove nothing.

# ── host-class flags ──
DF_DESKTOP=1     # Wayland desktop: bar, kanshi, notifications, ydotool
DF_QUADLET=0     # not a server
#DF_NODE=1       # commented-out hint: NOT an answer, must be uncommented in place
# DF_GO=0        # same, with a space after the "#"

# ── installer behaviour ──
#DF_STOW_BACKUP=0

# ── machine-specific environment ──
export MUSIC_EXPORT_ROOT="/media/medien/music/curated"
#export FPCALC="/usr/bin/fpcalc"
